<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.ecosystem_maintenance</string>
    
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>~/projects/project-tracker/scripts/maintenance.sh</string>
    </array>
    
    <!-- Run daily at 6:00 AM -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    
    <key>StandardOutPath</key>
    <string>~/projects/project-tracker/logs/maintenance.log</string>
    
    <key>StandardErrorPath</key>
    <string>~/projects/project-tracker/logs/maintenance_error.log</string>
    
    <key>WorkingDirectory</key>
    <string>~/projects/project-tracker</string>
    
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
