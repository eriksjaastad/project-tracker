<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    LaunchAgent: cr-sqlite sync daemon (Phase 2.1b).

    Runs the long-running process that replicates CRR tables over
    Tailscale. PR #3c-1 ships the scaffolding only — the replication
    payload is a stub until §2.4 proves cr-sqlite's bootstrap
    semantics on a trial table. The agent can land now because the
    outer loop (pause-aware, interval-driven, clean-shutdown) is
    what actually needs launchd persistence — the payload swap is a
    single-function change that doesn't affect this plist.

    The ``--peer-host`` argument MUST be edited per machine before
    installing: laptop sets it to Mini's tailnet hostname, Mini sets
    it to laptop's. MagicDNS resolves plain hostnames (no .tail... suffix
    needed); both tailnet and MagicDNS must be up for the peer ping in
    preflight to succeed.

    Install:
        # 1. Edit peer-host below for this machine.
        # 2. Copy and load:
        mkdir -p ~/Library/LaunchAgents ~/projects/project-tracker/logs
        cp ~/projects/project-tracker/scripts/launchd/com.pt.sync-daemon.plist \
           ~/Library/LaunchAgents/com.pt.sync-daemon.plist
        launchctl load ~/Library/LaunchAgents/com.pt.sync-daemon.plist

    Uninstall:
        launchctl unload ~/Library/LaunchAgents/com.pt.sync-daemon.plist
        rm ~/Library/LaunchAgents/com.pt.sync-daemon.plist

    Depends on com.pt.tailscale-up: the daemon's preflight peer-reachability
    check will fail if the tunnel isn't up yet. launchd does not expose a
    real "after" dependency for LaunchAgents, so the daemon just retries
    on preflight failure (exit 2 + launchd throttling brings it back on
    the next interval, by which point tailscale-up has usually succeeded).
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.pt.sync-daemon</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/eriksjaastad/.local/bin/uv</string>
        <string>run</string>
        <string>--project</string>
        <string>/Users/eriksjaastad/projects/project-tracker</string>
        <string>python</string>
        <string>-m</string>
        <string>scripts.db.sync_daemon</string>
        <string>--db-path</string>
        <string>/Users/eriksjaastad/projects/project-tracker/data/tracker.db</string>
        <string>--peer-host</string>
        <string>CHANGE-ME-PER-MACHINE</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>WorkingDirectory</key>
    <string>/Users/eriksjaastad/projects/project-tracker</string>

    <key>StandardOutPath</key>
    <string>/Users/eriksjaastad/projects/project-tracker/logs/sync-daemon.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/eriksjaastad/projects/project-tracker/logs/sync-daemon.err</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
