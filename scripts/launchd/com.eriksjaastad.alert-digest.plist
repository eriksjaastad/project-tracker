<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.eriksjaastad.alert-digest</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/eriksjaastad/projects/project-tracker/scripts/alert-digest.sh</string>
    </array>

    <!-- Fire at 7:00 AM local. If the Mac is asleep/closed at 7am, launchd runs
         the job on the next wake (built-in catch-up), so a closed laptop still
         gets its digest instead of silently skipping the day. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>7</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/eriksjaastad/projects/project-tracker/logs/alert_digest.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/eriksjaastad/projects/project-tracker/logs/alert_digest.stderr.log</string>

    <key>WorkingDirectory</key>
    <string>/Users/eriksjaastad/projects/project-tracker</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
